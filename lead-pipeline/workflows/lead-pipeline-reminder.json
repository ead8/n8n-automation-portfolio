  {
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT (SELECT count(*) FROM pipeline_events WHERE type = 'reminder.sent' AND created_at > now() - interval '70 minutes') AS sent, (SELECT count(*) FROM pipeline_events WHERE type = 'reminder.sent' AND (payload->>'late') = 'true' AND created_at > now() - interval '70 minutes') AS late, (SELECT count(*) FROM pipeline_events WHERE type = 'reminder.cancelled' AND created_at > now() - interval '70 minutes') AS cancelled",
    "options": {}
   },
   "id": "45adf02d-d22b-5f8c-9426-f8f8f3291425",
   "name": "Count Sweep Results",
   "type": "n8n-nodes-base.postgres",
