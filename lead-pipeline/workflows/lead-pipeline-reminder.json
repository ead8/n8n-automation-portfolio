  {
   "parameters": {
    "jsCode": "const j = $input.first().json || {};\nconst sent = Number(j.sent || 0);\nconst late = Number(j.late || 0);\nconst cancelled = Number(j.cancelled || 0);\nreturn [{\n  json: {\n    sent, late, cancelled, total: sent + cancelled,\n    text: 'Reminder sweep: ' + sent + ' reminders sent (' + late + ' late catch ups), '\n      + cancelled + ' meetings found cancelled, sales notified.',\n  },\n}];\n"
   },
   "id": "d384fd64-be3a-5b94-9b38-dcb71a90c8e9",
