  {
   "parameters": {
    "jsCode": "// Passes the lead row through unchanged and tags the reminder as\n// on time (late = false) or as a catch-up send (late = true).\nreturn $input.all().map((i) => ({ json: { ...i.json, late: false } }));\n"
   },
   "id": "08b006cd-42bf-5c7c-9bdf-ebb5424d5c4b",
   "name": "Lead Context",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    780,
