   ]
  },
  {
   "parameters": {
    "resource": "event",
    "operation": "get",
    "calendar": {
     "__rl": true,
     "value": "={{ $env.GOOGLE_CALENDAR_ID }}",
     "mode": "id"
    },
    "eventId": "={{ $json.event_id }}"
   },
   "id": "0cd4ebd9-b9eb-5312-a250-91d4900f02d5",
   "name": "Verify Event Still Exists",
   "type": "n8n-nodes-base.googleCalendar",
   "typeVersion": 1.3,
   "position": [
    1040,
    380
   ],
   "credentials": {
    "googleCalendarOAuth2": {
     "id": "",
     "name": "Google Calendar OAuth2 (placeholder, add your own)"
    }
   },
   "onError": "continueErrorOutput"
  },
  {
   "parameters": {
    "jsCode": "// The Google Calendar node replaces the item with the event (or an error),\n// so the lead context is restored from the context node via the paired item.\nconst idx = ($input.first().pairedItem || {}).item || 0;\nconst all = $('Lead Context').all();\nconst ctx = ((all[idx] || all[0] || {}).json) || {};\nlet when = ctx.meeting_start;\ntry { when = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: ctx.timezone || 'Africa/Addis_Ababa' }).format(new Date(ctx.meeting_start)); } catch (e) {}\nconst base = { leadId: ctx.id, name: ctx.name, phone: ctx.phone, email: ctx.email, eventId: ctx.event_id, meetingStartText: when, late: !!ctx.late };\nreturn [{ json: base }];\n"
   },
   "id": "2441aa4b-de94-5516-9ae9-152a25c4be61",
   "name": "Compose Reminder",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1300,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "=https://graph.facebook.com/v21.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
    "authentication": "none",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "={{ 'Bearer ' + $env.WHATSAPP_ACCESS_TOKEN }}"
      },
      {
       "name": "Content-Type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({\n  messaging_product: 'whatsapp',\n  to: $json.phone.replace('+', ''),\n  type: 'template',\n  template: {\n    name: 'meeting_reminder',\n    language: { code: 'en' },\n    components: [\n      { type: 'body', parameters: [\n        { type: 'text', text: $json.name },\n        { type: 'text', text: $json.meetingStartText }\n      ] },\n      { type: 'button', sub_type: 'quick_reply', index: '0', parameters: [{ type: 'payload', payload: 'CONFIRM' }] },\n      { type: 'button', sub_type: 'quick_reply', index: '1', parameters: [{ type: 'payload', payload: 'RESCHEDULE' }] }\n    ]\n  }\n}) }}",
    "options": {
     "timeout": 30000
    }
   },
